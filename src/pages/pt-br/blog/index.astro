---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog-pt")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFmt = (d: Date) => d.toLocaleDateString("pt-BR", { month: "long", day: "numeric", year: "numeric" });
---
<BaseLayout
  lang="pt-br"
  title="Blog sobre Imóveis em Dubai | Nova Casa Real Estate"
  description="Guias sobre comprar, alugar e investir em imóveis em Dubai, escritos pela Nova Casa Real Estate — propriedade freehold, taxas da DLD, guias de bairros e análise de mercado."
  ogPath="/pt-br/blog"
  currentNav="blog"
>
  <div class="page-hero">
    <div class="container">
      <span class="eyebrow">Blog da Nova Casa</span>
      <h1>Guias e conteúdo sobre comprar, alugar e investir em Dubai.</h1>
      <p class="lede">Artigos práticos e diretos da Nova Casa Real Estate — escritos para quem está realmente considerando comprar, não só navegando.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a class="blog-card" href={`/pt-br/blog/${post.id}`}>
            <div class="blog-card-media">
              <img src={post.data.coverImage} alt={post.data.coverAlt} loading="lazy">
              <span class="badge">{post.data.pillar}</span>
            </div>
            <div class="blog-card-body">
              <span class="blog-card-date">{dateFmt(post.data.publishDate)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Fragment slot="footer-tagline">Um caminho mais pessoal para o mercado imobiliário residencial e comercial de Dubai.</Fragment>
  <Fragment slot="footer-bottom-right"><span>Dubai, EAU</span></Fragment>
</BaseLayout>
