---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import business from "../../../content/business.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog-pt");
  return posts.map((post) => ({ params: { slug: post.id }, props: { entry: post } }));
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await render(entry);

const allPosts = (await getCollection("blog-pt")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const more = allPosts.filter((p) => p.id !== entry.id).slice(0, 2);

const dateFmt = (d: Date) => d.toLocaleDateString("pt-BR", { month: "long", day: "numeric", year: "numeric" });
---
<BaseLayout
  lang="pt-br"
  title={`${post.title} | Nova Casa Real Estate`}
  description={post.excerpt}
  ogPath={`/pt-br/blog/${entry.id}`}
  currentNav="blog"
>
  <div class="container blog-post-page">
    <p class="breadcrumb"><a href="/pt-br">Início</a> / <a href="/pt-br/blog">Blog</a> / {post.pillar}</p>

    <article class="post-layout">
      <header class="post-head">
        <span class="eyebrow">{post.pillar}</span>
        <h1>{post.title}</h1>
        <div class="post-meta">
          <span>Por {post.author}</span>
          <span aria-hidden="true">·</span>
          <span>{dateFmt(post.publishDate)}</span>
        </div>
      </header>

      <div class="post-cover">
        <img src={post.coverImage} alt={post.coverAlt}>
      </div>

      <div class="post-body">
        <Content />
      </div>

      <div class="post-cta">
        <h3>Pensando em comprar em Dubai?</h3>
        <p>A Carla pode te ajudar a entender sua situação específica — sem compromisso.</p>
        <div class="hero-actions">
          <a class="btn btn-whatsapp" data-whatsapp={`uma dúvida do post "${post.title}"`}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.7 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.2-3.6-.8-3-1.2-4.9-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.7-.1.3.1 1.7.8 2 .9.3.2.5.2.6.3.1.2.1.9-.1 1.6Z"/></svg>
            Falar no WhatsApp
          </a>
          <a class="btn btn-outline" href={`mailto:${business.email}`}>Enviar E-mail</a>
        </div>
      </div>
    </article>

    {more.length > 0 && (
      <div class="related-strip">
        <div class="section-head">
          <span class="eyebrow">Mais no blog</span>
          <h2>Continue lendo</h2>
        </div>
        <div class="blog-grid">
          {more.map((p) => (
            <a class="blog-card" href={`/pt-br/blog/${p.id}`}>
              <div class="blog-card-media">
                <img src={p.data.coverImage} alt={p.data.coverAlt} loading="lazy">
                <span class="badge">{p.data.pillar}</span>
              </div>
              <div class="blog-card-body">
                <span class="blog-card-date">{dateFmt(p.data.publishDate)}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <Fragment slot="footer-tagline">Um caminho mais pessoal para o mercado imobiliário residencial e comercial de Dubai.</Fragment>
  <Fragment slot="footer-bottom-right"><span>Dubai, EAU</span></Fragment>
</BaseLayout>
