---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import business from "../../content/business.json";
import site from "../../content/site/pt-br.json";

const properties = (await getCollection("properties-pt")).sort((a, b) => a.data.order - b.data.order);
const faqAll = await getCollection("faq-pt");
const teaserQuestions = ["comprando-1", "impostos-vistos-2", "impostos-vistos-3"];
const teaserItems = teaserQuestions
  .map((id) => faqAll.find((f) => f.id === id))
  .filter((f): f is NonNullable<typeof f> => Boolean(f))
  .map((f) => ({ question: f.data.question, answer: f.data.answer }));
---
<BaseLayout
  lang="pt-br"
  title="Nova Casa Real Estate — Imóveis em Dubai para Brasileiros"
  description="A Nova Casa Real Estate conecta brasileiros a oportunidades exclusivas de investimento imobiliário em Dubai. Licenciada pela RERA. Atendimento pessoal e transparente, em português."
  ogPath="/pt-br"
  currentNav="home"
>
  <section class="hero">
    <div class="hero-media">
      <img src={site.heroImage} alt={site.heroImageAlt}>
    </div>
    <div class="container hero-content">
      <span class="eyebrow">{site.heroEyebrow}</span>
      <h1>{site.heroTitle}</h1>
      <p class="lede">{site.heroLede}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#properties">Ver Imóveis</a>
        <a class="btn btn-outline btn-ghost-inverse" href="#contact">Falar com uma Corretora</a>
        <a class="btn btn-outline btn-ghost-inverse" href={business.youtubeUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="#FF0000" aria-hidden="true" style="width:16px;height:16px"><path d="M23 12s0-3.6-.5-5.3c-.3-1-1-1.8-2-2C18.7 4 12 4 12 4s-6.7 0-8.5.7c-1 .2-1.7 1-2 2C1 8.4 1 12 1 12s0 3.6.5 5.3c.3 1 1 1.7 2 2C5.3 20 12 20 12 20s6.7 0 8.5-.7c1-.3 1.7-1 2-2 .5-1.7.5-5.3.5-5.3ZM9.8 15.5V8.5L15.8 12l-6 3.5Z"/></svg>
          Ver Vídeos dos Imóveis
        </a>
        <a class="btn btn-bayut" href={business.bayutUrl} target="_blank" rel="noopener">
          <img src="/assets/img/bayut-icon.png" alt="" width="20" height="20">
          Ver no Bayut
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat"><b>{site.statListings}</b><span>Imóveis Exclusivos</span></div>
        <div class="stat"><b>{site.statPriceRange}</b><span>Faixa de Preço</span></div>
        <div class="stat"><b>RERA</b><span>Agência Licenciada</span></div>
        <div class="stat"><b>🇧🇷</b><span>Atendimento em Português</span></div>
      </div>
    </div>
  </section>

  <div class="trust-strip">
    <div class="container trust-row">
      {site.trustItems.map((label) => (
        <span class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4Z"/><path d="m9 12 2 2 4-4"/></svg>
          {label}
        </span>
      ))}
    </div>
  </div>

  <section id="properties">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{site.propertiesEyebrow}</span>
        <h2>{site.propertiesTitle}</h2>
        <p class="lede">{site.propertiesLede}</p>
      </div>
      <div class="property-grid">
        {properties.map((p) => (
          <PropertyCard
            slug={p.id}
            href={`/pt-br/properties/${p.id}`}
            title={p.data.title}
            location={p.data.location}
            price={p.data.price}
            purpose={p.data.purpose}
            beds={p.data.beds}
            baths={p.data.baths}
            size={p.data.size}
            image={p.data.images[0]}
            lang="pt-br"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt" id="about">
    <div class="container about-grid">
      <div class="agent-card">
        <div class="agent-photo">
          <img src="/assets/img/carla-santos.webp" alt={`${business.agentName}, corretora de imóveis da Nova Casa Real Estate`} width="480" height="580">
        </div>
        <div class="agent-name">{business.agentName}</div>
        <div class="agent-role">{site.agentRole}</div>
        <p>{site.agentBio}</p>
        <a class="btn btn-whatsapp btn-block" data-whatsapp={`uma consultoria com a ${business.agentName}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.7 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.2-3.6-.8-3-1.2-4.9-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.7-.1.3.1 1.7.8 2 .9.3.2.5.2.6.3.1.2.1.9-.1 1.6Z"/></svg>
          Falar com a Carla no WhatsApp
        </a>
        <a class="verify-link" href={business.dldVerifyUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4Z"/><path d="m9 12 2 2 4-4"/></svg>
          Verificar a licença da Carla
        </a>
      </div>
      <div>
        <span class="eyebrow">{site.aboutEyebrow}</span>
        <h2>{site.aboutTitle}</h2>
        {site.aboutParagraphs.map((p) => <p>{p}</p>)}
        <div class="stat-row">
          <div class="stat"><b>{business.rera}</b><span>Nº de Licença RERA</span></div>
          <div class="stat"><b>{properties.length}</b><span>Imóveis Ativos</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{site.servicesEyebrow}</span>
        <h2>{site.servicesTitle}</h2>
        <p class="lede">{site.servicesLede}</p>
      </div>
    </div>
    <div class="container">
      <div class="services-grid">
        {site.services.map((s, i) => (
          <div class="service-card">
            <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{site.faqTeaserEyebrow}</span>
        <h2>{site.faqTeaserTitle}</h2>
        <p class="lede">{site.faqTeaserLede}</p>
      </div>
      <div class="faq-list">
        {teaserItems.map((item) => (
          <div class="faq-item" data-open="false">
            <button class="faq-q" aria-expanded="false"><span>{item.question}</span><span class="plus" aria-hidden="true"></span></button>
            <div class="faq-a"><div class="faq-a-inner"><p>{item.answer}</p></div></div>
          </div>
        ))}
      </div>
      <p style="margin-top:2rem"><a class="btn btn-outline" href="/pt-br/faq">Ver o Guia Completo para Brasileiros</a></p>
    </div>
  </section>

  <section id="contact">
    <div class="container contact-grid">
      <div>
        <span class="eyebrow">{site.contactEyebrow}</span>
        <h2>{site.contactTitle}</h2>
        <p class="lede">{site.contactLede}</p>
        <ContactForm lang="pt-br" propertyTitles={properties.map((p) => p.data.title)} />
      </div>
      <div>
        <div class="contact-info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"/></svg>
          <div><h4>Telefone &amp; WhatsApp</h4><a href={`tel:${business.phoneHref}`}>{business.phone}</a></div>
        </div>
        <div class="contact-info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16v16H4z"/><path d="m4 6 8 6 8-6"/></svg>
          <div><h4>E-mail</h4><a href={`mailto:${business.email}`}>{business.email}</a></div>
        </div>
        <div class="contact-info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c-4.4-4-7-7.6-7-11a7 7 0 0 1 14 0c0 3.4-2.6 7-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <div><h4>Localização</h4><span class="value">Dubai, Emirados Árabes Unidos</span></div>
        </div>
        <div class="contact-info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4Z"/></svg>
          <div><h4>Licença RERA</h4><span class="value">Nº {business.rera}</span></div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer-tagline">{site.footerTagline}</Fragment>
  <Fragment slot="footer-bottom-right"><span>Dubai, EAU</span></Fragment>
</BaseLayout>
