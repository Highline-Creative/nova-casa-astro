---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqCategory from "../components/FaqCategory.astro";

const faq = await getCollection("faq-en");
const byCategory = (id: string) => faq.filter((f) => f.data.category === id).sort((a, b) => a.data.order - b.data.order).map((f) => f.data);

const categories = [
  { id: "buying", pill: "Buying", heading: "Buying property in Dubai" },
  { id: "fees", pill: "Costs & Fees", heading: "Government fees and closing costs" },
  { id: "renting", pill: "Renting", heading: "Renting in Dubai" },
  { id: "legal", pill: "Legal & Residency", heading: "Legal framework, RERA & residency" },
  { id: "investing", pill: "Investing", heading: "Investing with Nova Casa" },
];
---
<BaseLayout
  lang="en"
  title="Dubai Real Estate Guide & FAQ | Nova Casa Real Estate"
  description="A practical guide to buying, renting and investing in Dubai real estate — freehold ownership, DLD fees, Ejari, mortgages for non-residents and more. By Nova Casa Real Estate."
  ogPath="/faq"
  currentNav="faq"
>
  <div class="page-hero">
    <div class="container">
      <span class="eyebrow">Dubai Real Estate Guide</span>
      <h1>Everything you need to know before buying, renting or investing in Dubai.</h1>
      <p class="lede">General guidance from Nova Casa Real Estate on freehold ownership, government fees, tenancy rules and residency options. Regulations and fees can change — always confirm current figures with our team or the relevant authority before making a decision.</p>
    </div>
  </div>

  <section>
    <div class="container">
      {categories.map((cat) => (
        <FaqCategory id={cat.id} pill={cat.pill} heading={cat.heading} items={byCategory(cat.id)} />
      ))}

      <div class="text-center" style="max-width:640px;margin-top:4rem">
        <h2>Still have questions?</h2>
        <p class="lede text-center">Carla and the Nova Casa team are happy to talk through your specific situation — no obligation.</p>
        <div class="hero-actions" style="justify-content:center">
          <a class="btn btn-whatsapp" data-whatsapp="a question from the Dubai Real Estate Guide page">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.7 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.2-3.6-.8-3-1.2-4.9-4.2-5-4.4-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.2.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.7.3.1.5.1.7-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.7-.1.3.1 1.7.8 2 .9.3.2.5.2.6.3.1.2.1.9-.1 1.6Z"/></svg>
            Ask on WhatsApp
          </a>
          <a class="btn btn-outline" href="/#contact">Contact Form</a>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer-tagline">A more personalised path into Dubai's residential and commercial property market.</Fragment>
  <Fragment slot="footer-bottom-right"><span>This page provides general information, not legal, tax or financial advice.</span></Fragment>
</BaseLayout>
